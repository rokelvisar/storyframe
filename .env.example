# Copy to .env for `docker compose` / `npm run docker:run`.

# noop  -> deterministic heuristic, no external calls (default for local dev)
# litellm -> OpenAI-compatible gateway; falls back to noop if BASE_URL is empty
ANALYSIS_PROVIDER=noop

# OpenAI-compatible gateway (e.g. LiteLLM) -- see docs/configuration.md
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_VLM_MODEL=
LITELLM_WHISPER_MODEL=

# FFmpeg granular worker pool size
FFMPEG_WORKERS=2

# Optional: import directly from a self-hosted Immich instance -- see docs/immich-integration.md
IMMICH_BASE_URL=
IMMICH_API_KEY=
IMMICH_WRITEBACK=

# Optional: transcription language hint / VLM output language -- see docs/language.md
TRANSCRIBE_LANGUAGE_HINT=
OUTPUT_LANGUAGE=

# Optional: persist jobs in MySQL/MariaDB instead of the local SQLite file -- see docs/previous-videos.md
MYSQL_DSN=
